{
  "name": "portal",
  "version": "2.0.0",
  "description": "Singapore Government Design System portal",
  "main": "",
  "scripts": {
    "dev:lib": "cd ../lib/sgds && npm run dev",
    "dev": "concurrently \"npm run dev:lib\" \" webpack --mode=development && bundle exec jekyll serve\"",
    "build:jekyll": "bundle exec jekyll build --config.yml",
    "build:jekyll:dev": "bundle exec jekyll build --config _config_dev.yml",
    "build:js": "webpack --mode=production",
    "build": "npm run build:js && npm run build:jekyll",
    "build:dev": "npm run build:js && npm run build:jekyll:dev"
  },
  "author": "Tey Liang Tai",
  "license": "MIT",
  "dependencies": {
    "@govtechsg/sgds": "file:../lib/sgds",
    "bootstrap": "^5.1.3"
  },
  "devDependencies": {
    "concurrently": "^7.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "image-minimizer-webpack-plugin": "^3.8.3",
    "imagemin": "^8.0.1",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-jpegtran": "^7.0.0",
    "imagemin-optipng": "^8.0.0",
    "imagemin-svgo": "^10.0.1",
    "lodash": "^4.17.21",
    "mini-css-extract-plugin": "^2.8.1",
    "sass": "~1.49.9",
    "sass-loader": "^14.2.1",
    "webpack": "^5.70.0",
    "webpack-cli": "^5.1.4"
  }
}
