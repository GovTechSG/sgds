{
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "mout": ">=1.2.4"
    }
  },
  "devDependencies": {
    "@govtechsg/oobee": "^0.10.93",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.12",
    "vitepress-sidebar": "^1.33.0",
    "vue": "^3.5.24"
  },
  "scripts": {
    "docs:dev": "node scripts/generate-component-updates.mjs && vitepress dev docs",
    "docs:build": "node scripts/generate-component-updates.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:a11y": "pnpm docs:build && node scripts/a11y-test.mjs",
    "test:a11y:setup": "cd node_modules/@govtechsg/oobee && pnpm install && pnpm run build && pnpm exec playwright install chromium"
  },
  "dependencies": {
    "@adobe/leonardo-contrast-colors": "^1.1.0",
    "@govtechsg/sgds-web-component": "3.22.1",
    "gsap": "^3.13.0"
  }
}
